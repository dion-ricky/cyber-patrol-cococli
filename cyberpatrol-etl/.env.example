# Required: PostgreSQL connection URL for the Snowflake Postgres instance
DATABASE_URL=postgres://user:password@host:5432/scanner

# Required: Snowflake auth via programmatic access token (unattended/headless)
SNOWFLAKE_ACCOUNT=ca06054.ap-southeast-3.aws
SNOWFLAKE_USER=DIONRICKY
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=CYBERPATROL_ETL_ROLE

# Target database/schema in Snowflake for the loaded tables
SNOWFLAKE_DATABASE=CYBERPATROL
SNOWFLAKE_SCHEMA=RAW

# How often the loop re-runs the ETL, in seconds (docker-compose only)
ETL_INTERVAL_SECONDS=1800
